# ==============================================================================
# EduShare+ / SkillSync - Comprehensive Root .gitignore
# Giúp tối ưu dung lượng, loại bỏ node_modules, build cache, target, file rác
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Angular 18, Node.js, NPM)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.angular/
**/.angular/
dist/
**/dist/
build/
**/build/
.cache/
**/.cache/
.eslintcache
**/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output & report files từ lint / karma / sonar
coverage/
**/coverage/
frontend/test-output*.txt
frontend/test_results.txt
frontend/lint*.txt
frontend/lint*.json
frontend/coverage_table.txt
frontend/full_lint.txt

# ------------------------------------------------------------------------------
# 2. BACKEND (Java 17, Spring Boot, Maven)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
**/*.class
*.jar
**/*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
**/*.war
*.ear
**/*.ear
out/
**/out/
bin/
**/bin/

# ------------------------------------------------------------------------------
# 3. PYTHON (AI Service, FastAPI, RAG, PyMuPDF)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
*.egg-info/
**/*.egg-info/

# ------------------------------------------------------------------------------
# 4. SENSITIVE FILES & SECRETS (Bảo mật tài khoản, API key)
# ------------------------------------------------------------------------------
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
!**/.env.example
*.key
*.pem
*.cert
*.crt
secrets/
**/secrets/
application-local.properties
application-local.yml
application-prod.properties
application-prod.yml

# ------------------------------------------------------------------------------
# 5. DOCKER & DATABASE STORAGE (Dung lượng lớn của container)
# ------------------------------------------------------------------------------
docker-compose.override.yml
*-db-data/
**/*-db-data/
minio-data/
**/minio-data/
edushare_data/
**/edushare_data/
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 6. IDEs & TEXT EDITORS
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iml
**/*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
**/.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Eclipse / STS
.settings/
**/.settings/
.classpath
**/.classpath
.project
**/.project
.factorypath
**/.factorypath
.metadata/
**/.metadata/

# Sublime / Atom / Vim
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. LOGS & TEMPORARY FILES
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
*.tmp
**/*.tmp
*.temp
**/*.temp
*.bak
**/*.bak

# File nén zip không cần thiết
*.zip
backend/payment-gateway.zip

# ------------------------------------------------------------------------------
# 8. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.DS_Store?
._*
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini
**/desktop.ini

